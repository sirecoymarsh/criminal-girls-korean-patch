{"rows":[{"source_id":"src_0001","target_ko":"보물이다!"},{"source_id":"src_0002","target_ko":"쓸 수 있나아?"},{"source_id":"src_0003","target_ko":"짐, 무거워…"},{"source_id":"src_0004","target_ko":"흥, 쩨쩨하네!"},{"source_id":"src_0005","target_ko":"그럼 그럼…"},{"source_id":"src_0006","target_ko":"유코 사랑해―!"},{"source_id":"src_0008","target_ko":"아― 짜증 났어!!"},{"source_id":"src_0009","target_ko":"칫, 이게 다냐"},{"source_id":"src_0010","target_ko":"헤헹, 사코 대승리!"},{"source_id":"src_0011","target_ko":"손, 내밀어…"},{"source_id":"src_0012","target_ko":"다들 녹초가 됐네"},{"source_id":"src_0013","target_ko":"유코 차례일까?"},{"source_id":"src_0014","target_ko":"회복시킬게"},{"source_id":"src_0015","target_ko":"아직도 걷게 할 거야!?"},{"source_id":"src_0016","target_ko":"응? 여기면 돼?"},{"source_id":"src_0017","target_ko":"아 진짜, 귀찮네…"},{"source_id":"src_0018","target_ko":"길은… 계속돼…"},{"source_id":"src_0019","target_ko":"진짜냐…"},{"source_id":"src_0020","target_ko":"정말!"},{"source_id":"src_0021","target_ko":"너무해…"},{"source_id":"src_0022","target_ko":"보물 보물…♪"},{"source_id":"src_0023","target_ko":"없어! 전부 챙긴 것 같아"},{"source_id":"src_0024","target_ko":"있다! 보물 기척이야!"},{"source_id":"src_0025","target_ko":"비켜 비켜, 란 님 나가신다!"},{"source_id":"src_0026","target_ko":"이걸로 됐고"},{"source_id":"src_0027","target_ko":"빨리 안내하라고"},{"source_id":"src_0028","target_ko":"흥, 우쭐대지 마"},{"source_id":"src_0029","target_ko":"따라… 갈 거야…"},{"source_id":"src_0030","target_ko":"유코 만날 때까지만이다!"},{"source_id":"src_0031","target_ko":"어디 갈 생각이야!"},{"source_id":"src_0032","target_ko":"다음 전투가 기대되네"},{"source_id":"src_0033","target_ko":"자, 공부할 시간이야"},{"source_id":"src_0045","target_ko":"바이바이…"},{"source_id":"src_0046","target_ko":"아앙… 지쳤어!"},{"source_id":"src_0047","target_ko":"이제… 싫어…"},{"source_id":"src_0048","target_ko":"어두워… 추워… 삭막해…"},{"source_id":"src_0049","target_ko":"센스라곤 눈곱만큼도 없네"},{"source_id":"src_0050","target_ko":"…호화로워도 곤란하지만"},{"source_id":"src_0051","target_ko":"어머, 괜찮잖아!"},{"source_id":"src_0052","target_ko":"앗, 기뻐!"},{"source_id":"src_0053","target_ko":"좋은 거
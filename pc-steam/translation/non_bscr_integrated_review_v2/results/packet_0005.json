{"rows":[{"source_id":"src_0334","target_ko":"다들 어디 간 걸까?"},{"source_id":"src_0335","target_ko":"…우릴 두고 간 걸까."},{"source_id":"src_0336","target_ko":"합류하면 설교 좀 해야겠네."},{"source_id":"src_0337","target_ko":"잠깐! 어디 갈 생각이야!?"},{"source_id":"src_0338","target_ko":"선생님, 열쇠를 찾아야지!"},{"source_id":"src_0339","target_ko":"코코아 마시고 싶어어!"},{"source_id":"src_0340","target_ko":"안아 줄게… 꼬옥…"},{"source_id":"src_0341","target_ko":"어, 어때…?"},{"source_id":"src_0342","target_ko":"정말 아무것도 없네…"},{"source_id":"src_0343","target_ko":"아… 열려 버렸어…"},{"source_id":"src_0344","target_ko":"이번에야말로 다 같이!"},{"source_id":"src_0345","target_ko":"그나저나, 그 자식…"},{"source_id":"src_0346","target_ko":"절대 용서 못 해!"},{"source_id":"src_0347","target_ko":"제대로 대가를 치르게 해야지."},{"source_id":"src_0348","target_ko":"추워… 그래도…"},{"source_id":"src_0349","target_ko":"신 씨가 기다리고 있으니까."},{"source_id":"src_0350","target_ko":"그래, 전속력으로 가자!"},{"source_id":"src_0351","target_ko":"몸조심해!"},{"source_id":"src_0352","target_ko":"뭐야!"},{"source_id":"src_0354","target_ko":"하아… 귀찮네…"},{"source_id":"src_0355","target_ko":"하아… 무사해서 다행이야."},{"source_id":"src_0356","target_ko":"뭐야, 그거 비꼬는 거야!?"},{"source_id":"src_0357","target_ko":"싸, 싸우면 안 돼…!"},{"source_id":"src_0358","target_ko":"기다려, 지금은 무리야!"},{"source_id":"src_0359","target_ko":"사코 씨… 조심해."},{"source_id":"src_0360","target_ko":"……!"},{"source_id":"src_0361","target_ko":"눈… 많이 내리네요."},{"source_id":"src_0362","target_ko":"왠지… 쓸쓸해…"},{"source_id":"src_0363","target_ko":"…유코……"},{"source_id":"src_0364","target_ko":"따라왔다가 떨어졌다가…"},{"source_id":"src_0365","target_ko":"히메카미는 신기해…"},{"source_id":"src_0366","target_ko":"자, 빨리 가라고!"},{"source_id":"src_0367","target_ko":"아, 눈이…"},{"source_id":"src_0368","target_ko":"눈이… 그쳤어."},{"source_id":"src_0369","target_ko":"선생님… 힘내는 거야."},{"source_id":"src_0370","target_ko":"선생님, 포기하면 안 돼."},{"source_id":"src_0371","target_ko":"마음은 분명 전해질 거야…"},{"source_id":"src_0372","target_ko":"여기서 사코에게 상처를 줬어…"},{"source_id":"src_0373","target_ko":"아니야, 고마워 유코."},{"source_id":"src_0374","target_ko":"이제 사코는 약하지 않아!"},{"source_id":"src_0375","target_ko":"아무것도 없잖아."},{"source_id":"src_0376","target_ko":"이제 아무도 못 막아!"},{"source_id":"src_0377","target_ko":"모두의 마음을 농락하고…"},{"source_id":"src_0378","target_ko":"용서 못 해…!"},{"source_id":"src_0379","target_ko":"본때를 보여 주겠어!"},{"source_id":"src_0380","target_ko":"아래층 더위가 그립네."},{"source_id":"src_0381","target_ko":"겨울엔 여름이 그립다… 그런 건가?"},{"source_id":"src_0382","target_ko":"난 겨울이 더 좋아."},{"source_id":"src_0383","target_ko":"또 이 장치야!?"},{"source_id":"src_0384","target_ko":"열렸어, 가자."},{"source_id":"src_0385","target_ko":"대체 뭐야!"},{"source_id":"src_0386","target_ko":"아저씨… 실망했다…"},{"source_id":"src_0387","target_ko":"하지만… 아니, 아무것도 아니야."},{"source_id":"src_0388","target_ko":"우리, 어떻게 되는 걸까…"},{"source_id":"src_0389","target_ko":"나도 참 쓸모없네…"},{"source_id":"src_0390","target_ko":"걱정 마, 내가 지켜 줄게."},{"source_id":"src_0391","target_ko":"사코도… 걱정돼…"},{"source_id":"src_0392","target_ko":"이렇게 쉽게 열리다니."},{"source_id":"src_0393","target_ko":"자, 이번엔 진짜 가자!"},{"source_id":"src_0394","target_ko":"빨리, 빨리…!"},{"source_id":"src_0395","target_ko":"그러게, 빨리 위로 올라가서…"},{"source_id":"src_0396","target_ko":"확실히 킬해 주겠어!"},{"source_id":"src_0397","target_ko":"선생님, 꽤 추워 보이네."},{"source_id":"src_0398","target_ko":"유코가 꼭 붙어 줄게!"},{"source_id":"src_0399","target_ko":"야, 야 유코!?"},{"source_id":"src_0400","target_ko":"그 애 손, 떨리고 있었어…"},{"source_id":"src_0401","target_ko":"…서둘러 돌아가자."},{"source_id":"src_0402","target_ko":"기다려, 이번엔 내가…"},{"source_id":"src_0403","target_ko":"뭔가… 보여…"},{"source_id":"src_0404","target_ko":"이런 건 그냥 문일 뿐이야!"},{"source_id":"src_0405","target_ko":"조금만 더 가면… 도착해!"},{"source_id":"src_0406","target_ko":"슬슬 때가 됐네…!"},{"source_id":"src_0407","target_ko":"좋아, 유코 준비됐어?"},{"source_id":"src_0408","target_ko":"응, 해치워 버리자!"},{"source_id":"src_0409","target_ko":"찾았어, 이거 아니야?"},{"source_id":"src_0410","target_ko":"히메카미…… 기다리고 있어."},{"source_id":"src_0411","target_ko":"빨리 돌아가요!"},{"source_id":"src_0412","target_ko":"좋은 거, 찾았어…!"},{"source_id":"src_0413","target_ko":"에취!"},{"source_id":"src_0414","target_ko":"감기, 조심하는 거야…"}]}

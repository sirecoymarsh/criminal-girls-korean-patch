{"rows":[{"source_id":"src_0495","target_ko":"워프투성이네…"},{"source_id":"src_0496","target_ko":"나아갈 수밖에 없겠네."},{"source_id":"src_0497","target_ko":"불길한… 느낌이 들어…"},{"source_id":"src_0498","target_ko":"있잖아, 소녀 지옥이란 건…"},{"source_id":"src_0499","target_ko":"악취미인 구역 이름이네."},{"source_id":"src_0500","target_ko":"수상한 울림…이야…"},{"source_id":"src_0501","target_ko":"나… 못 하겠어… 이제… 싫어…"},{"source_id":"src_0502","target_ko":"부탁이야… 그만해……!"},{"source_id":"src_0503","target_ko":"나한테… 기대하지 마!"},{"source_id":"src_0504","target_ko":"미안해…"},{"source_id":"src_0505","target_ko":"미안…해…"},{"source_id":"src_0506","target_ko":"모… 모두… 잘 부탁해…"},{"source_id":"src_0507","target_ko":"흐―응…"},{"source_id":"src_0508","target_ko":"네가 기사 후보야?"},{"source_id":"src_0509","target_ko":"에에― 뭔가 허접하지 않아?"},{"source_id":"src_0510","target_ko":"미… 미안해… 하지만…"},{"source_id":"src_0511","target_ko":"이게 내 역할이니까…"},{"source_id":"src_0512","target_ko":"이 녀석이 우리를 정화한다고?"},{"source_id":"src_0513","target_ko":"시시해 빠졌어!!"},{"source_id":"src_0514","target_ko":"역시 착한 아이네!"},{"source_id":"src_0515","target_ko":"또 점수 따기냐―!"},{"source_id":"src_0516","target_ko":"나… 그런 생각은…"},{"source_id":"src_0517","target_ko":"기사님 후보는 여유롭네―"},{"source_id":"src_0518","target_ko":"꺄하하하!"},{"source_id":"src_0519","target_ko":"선생님… 나… 이제 못 하겠어…"},{"source_id":"src_0520","target_ko":"정신 차려!"},{"source_id":"src_0521","target_ko":"넌 기사가 되는 거야!"},{"source_id":"src_0523","target_ko":"선생님… 사코 강해지고 싶어"},{"source_id":"src_0524","target_ko":"레벨업이라도 할래?"},{"source_id":"src_0525","target_ko":"유코 씨… 가차 없네…"},{"source_id":"src_0526","target_ko":"네가 그런 식이면"},{"source_id":"src_0527","target_ko":"나도 곤란하다고!!"},{"source_id":"src_0528","target_ko":"미… 미안해……"},{"source_id":"src_0529","target_ko":"기사 후보잖아?"},{"source_id":"src_0530","target_ko":"조금은 도움이 되란 말이야!"},{"source_id":"src_0531","target_ko":"왜 내가 선택된 거야…?"},{"source_id":"src_0532","target_ko":"이젠 싫어… 돌아가고 싶어……"},{"source_id":"src_0533","target_ko":"왜, 너는"},{"source_id":"src_0534","target_ko":"이런 것도 못 하는 거야!?"},{"source_id":"src_0535","target_ko":"늘 우등생 행세나 하고…"},{"source_id":"src_0536","target_ko":"존나 짜증난다고!"},{"source_id":"src_0537","target_ko":"기사 기사 떠들며 잘난 척하긴!"},{"source_id":"src_0538","target_ko":"진짜 짐 덩어리야!"},{"source_id":"src_0539","target_ko":"네가 기사라니 무리무리!"},{"source_id":"src_0540","target_ko":"히메카미 씨!"},{"source_id":"src_0541","target_ko":"아직도 제대로 못 이끌다니…"},{"source_id":"src_0542","target_ko":"어떻게 된 거야!?"},{"source_id":"src_0543","target_ko":"서… 선생님… 미안해…"},{"source_id":"src_0544","target_ko":"하지만……"},{"source_id":"src_0545","target_ko":"됐으니까, 빨리!!"},{"source_id":"src_0546","target_ko":"이걸 써서 기사화해!"},{"source_id":"src_0547","target_ko":"시… 싫어… 싫어…!"},{"source_id":"src_0548","target_ko":"아무도 알아주지 않아…"},{"source_id":"src_0549","target_ko":"…이젠 됐어"},{"source_id":"src_0550","target_ko":"나…"},{"source_id":"src_0551","target_ko":"이제 와 하는 말이지만, 여자뿐이네."},{"source_id":"src_0552","target_ko":"그러고 보니 그렇네."},{"source_id":"src_0553","target_ko":"하렘이네, 아저씨!"},{"source_id":"src_0575","target_ko":"미우 씨, 있으려나…"},{"source_id":"src_0576","target_ko":"이 앞에서… 기척이 느껴져…"},{"source_id":"src_0577","target_ko":"선생니임! 안 피곤해?"},{"source_id":"src_0578","target_ko":"몸 좀 풀어 줄까?"},{"source_id":"src_0579","target_ko":"아… 노림수야…!"},{"source_id":"src_0580","target_ko":"벌주기… 벌주기…"},{"source_id":"src_0581","target_ko":"앨리스, 너…!?"},{"source_id":"src_0582","target_ko":"하아… 무슨 미연시야…"},{"source_id":"src_0583","target_ko":"기다려, 히메카미!"},{"source_id":"src_0584","target_ko":"히메카미… 끝내자고"},{"source_id":"src_0585","target_ko":"아야노… 기다려…"},{"source_id":"src_0586","target_ko":"히메카미 씨, 지금 갈게."},{"source_id":"src_0587","target_ko":"히메카미를 구하는 거야…!"},{"source_id":"src_0588","target_ko":"이번엔 유코들이 구할 차례네…!"},{"source_id":"src_0589","target_ko":"이번에야말로 끝내자."},{"source_id":"src_0590","target_ko":"부숴야 해… 전부…"},{"source_id":"src_0591","target_ko":"좋겠다― 나도 어려지고 싶어."},{"source_id":"src_0592","target_ko":"뭐야, 아직 젊잖아."},{"source_id":"src_0593","target_ko":"나보다 어린 애한테 듣기 싫어."},{"source_id":"src_0594","target_ko":"가자! 얘들아!"},{"source_id":"src_0595","target_ko":"간다! 나를 따라와!"},{"source_id":"src_0596","target_ko":"다 같이, 하는 거야!"}]}

{"rows":[{"source_id":"src_0173","target_ko":"좋아! 냉찜질, 냉찜질!"},{"source_id":"src_0174","target_ko":"이거면 발을 식힐 수 있어!"},{"source_id":"src_0175","target_ko":"마실 거, 마실 거!"},{"source_id":"src_0176","target_ko":"유코가 좋아할까!"},{"source_id":"src_0177","target_ko":"꺄! 꺄아!"},{"source_id":"src_0178","target_ko":"사코, 또 함께네!"},{"source_id":"src_0179","target_ko":"응, 그러네! 유코!"},{"source_id":"src_0180","target_ko":"휴식, 벌써 끝이야…?"},{"source_id":"src_0181","target_ko":"유코, 괜찮아!?"},{"source_id":"src_0182","target_ko":"응, 괜찮아."},{"source_id":"src_0183","target_ko":"덥고 답답하네, 정말…"},{"source_id":"src_0184","target_ko":"저 보물상자!!"},{"source_id":"src_0185","target_ko":"갈 곳은, 어디더라…"},{"source_id":"src_0186","target_ko":"앗, 약초다!"},{"source_id":"src_0187","target_ko":"오오, 그립네."},{"source_id":"src_0188","target_ko":"정말… 약… 맞아?"},{"source_id":"src_0189","target_ko":"음―, 뭐지?"},{"source_id":"src_0190","target_ko":"저건…"},{"source_id":"src_0191","target_ko":"안 열려… 어떡하지…"},{"source_id":"src_0192","target_ko":"앗, 열렸나?"},{"source_id":"src_0193","target_ko":"휴식, 아직 멀었나…"},{"source_id":"src_0194","target_ko":"유코, 괜찮아?"},{"source_id":"src_0195","target_ko":"이렇게나… 걷다니…"},{"source_id":"src_0196","target_ko":"그 모양으로 괜찮겠어…"},{"source_id":"src_0197","target_ko":"어… 무슨 소리야!?"},{"source_id":"src_0198","target_ko":"문이… 닫혔어…!"},{"source_id":"src_0199","target_ko":"정말 열 수 있겠어…?"},{"source_id":"src_0200","target_ko":"언제까지 기다리게 할 거야!?"},{"source_id":"src_0201","target_ko":"오! 열린 것 같아!"},{"source_id":"src_0202","target_ko":"스위치가 어디야…"},{"source_id":"src_0203","target_ko":"일단 나아가자…"},{"source_id":"src_0204","target_ko":"여긴 꽝인가…"},{"source_id":"src_0205","target_ko":"여기도 꽝이야…"},{"source_id":"src_0206","target_ko":"이것도 꽝이잖아!"},{"source_id":"src_0207","target_ko":"토모에 머리, 윤기가 나네."},{"source_id":"src_0208","target_ko":"그래? 분명 습해진 것뿐이야."},{"source_id":"src_0209","target_ko":"그래, 그래… 그건 나중에 해."},{"source_id":"src_0210","target_ko":"저기, 저거!"},{"source_id":"src_0211","target_ko":"다음엔 뭐가 있을까!"},{"source_id":"src_0212","target_ko":"축축… 끈적끈적…"},{"source_id":"src_0213","target_ko":"아 정말! 샤워 아직이야!"},{"source_id":"src_0214","target_ko":"킁킁… 땀 냄새 나…?"},{"source_id":"src_0215","target_ko":"여기 맞아?"},{"source_id":"src_0216","target_ko":"란, 저렇게 겁먹어서…"},{"source_id":"src_0217","target_ko":"무슨 일이… 있었나 봐요."},{"source_id":"src_0218","target_ko":"과거 따위…"},{"source_id":"src_0219","target_ko":"어머, 뭐니?"},{"source_id":"src_0220","target_ko":"으으음!?"},{"source_id":"src_0221","target_ko":"어쩌면 좋을까?"},{"source_id":"src_0222","target_ko":"이걸로 열렸어?"},{"source_id":"src_0223","target_ko":"이 탑, 너무 커어…"},{"source_id":"src_0224","target_ko":"하아… 어깨 결리네…"},{"source_id":"src_0225","target_ko":"나머지 1명은 어디 간 거야"},{"source_id":"src_0226","target_ko":"글쎄, 어떨까?"},{"source_id":"src_0227","target_ko":"왠지 잘 기억이 안 나…"},{"source_id":"src_0228","target_ko":"이 소리… 그 녀석 설마…!"},{"source_id":"src_0229","target_ko":"이놈 선공형이냐!"},{"source_id":"src_0230","target_ko":"잠깐… 빨리 타겟 떼!"},{"source_id":"src_0231","target_ko":"타겟? 무슨 말일까?"},{"source_id":"src_0232","target_ko":"꽤 머네…"},{"source_id":"src_0233","target_ko":"굉장한 거 바―견!!"},{"source_id":"src_0234","target_ko":"떠오르네, 처음 때가…"},{"source_id":"src_0235","target_ko":"그래, 고생깨나 했지."},{"source_id":"src_0236","target_ko":"이젠 시효 지났잖아, 잊어 줘."},{"source_id":"src_0237","target_ko":"아, 젠장, 답답해!"},{"source_id":"src_0238","target_ko":"란 씨, 진정해."},{"source_id":"src_0239","target_ko":"조금만 더야, 앨리스…"},{"source_id":"src_0240","target_ko":"헤에, 딱 봐도 보스방이네."},{"source_id":"src_0241","target_ko":"무, 무서워, 사코…"},{"source_id":"src_0242","target_ko":"괘, 괜찮아, 유코!"},{"source_id":"src_0243","target_ko":"두근두근…"},{"source_id":"src_0244","target_ko":"일단 받아 둘게."},{"source_id":"src_0245","target_ko":"대충 이 정도일까."},{"source_id":"src_0246","target_ko":"발목 잡는 건 사양이야."},{"source_id":"src_0247","target_ko":"섭씨 88도…라…"},{"source_id":"src_0248","target_ko":"그런데도 움직일 수 있다니…"},{"source_id":"src_0249","target_ko":"역시 죽은 사람이긴 하네…"},{"source_id":"src_0250","target_ko":"도망쳤어…"},{"source_id":"src_0251","target_ko":"젠장, 쫓아가자!"},{"source_id":"src_0252","target_ko":"쫄랑쫄랑거리기는―!!"}]}

{"rows":[{"source_id":"src_0253","target_ko":"놓치지 않을 거야!"},{"source_id":"src_0254","target_ko":"정말 이쪽이 맞을까?"},{"source_id":"src_0255","target_ko":"앨리스는 특별해…"},{"source_id":"src_0256","target_ko":"어때, 알겠어?"},{"source_id":"src_0257","target_ko":"……이쪽이야"},{"source_id":"src_0258","target_ko":"있지, 아직이야?"},{"source_id":"src_0259","target_ko":"조금만… 더야"},{"source_id":"src_0260","target_ko":"아이스크림 먹고 싶어―!"},{"source_id":"src_0261","target_ko":"그러고 보니, 지옥이었어"},{"source_id":"src_0262","target_ko":"그래, 잊을 뻔했네"},{"source_id":"src_0263","target_ko":"…너희 너무 적응했잖아"},{"source_id":"src_0264","target_ko":"선생님, 저거…"},{"source_id":"src_0265","target_ko":"저 변태 자식…!!"},{"source_id":"src_0266","target_ko":"어, 엄청 화났네…"},{"source_id":"src_0267","target_ko":"절대 용서 못 해!!"},{"source_id":"src_0268","target_ko":"놓치지 않아… 어디야!"},{"source_id":"src_0269","target_ko":"잡아다가 박살 내 주겠어!"},{"source_id":"src_0270","target_ko":"있지, 어떡할 거야?"},{"source_id":"src_0271","target_ko":"후후, 아직 비밀이야!"},{"source_id":"src_0272","target_ko":"잠깐, 아직이야!?"},{"source_id":"src_0273","target_ko":"음, 아직이네…"},{"source_id":"src_0274","target_ko":"있지, 이제 그만 좀…!"},{"source_id":"src_0275","target_ko":"그러게, 슬슬 됐으려나"},{"source_id":"src_0276","target_ko":"더워어… 사코―…"},{"source_id":"src_0277","target_ko":"덥다 덥다 시끄러워―!"},{"source_id":"src_0278","target_ko":"지, 진정해…"},{"source_id":"src_0279","target_ko":"이거, 그거지?"},{"source_id":"src_0280","target_ko":"나도 머리를 묶을까…"},{"source_id":"src_0281","target_ko":"그럼 내가 해 줄까?"},{"source_id":"src_0282","target_ko":"아예 짧게 자르면 편하다구"},{"source_id":"src_0283","target_ko":"토모에, 괜찮을까?"},{"source_id":"src_0284","target_ko":"응, 걱정되네…"},{"source_id":"src_0285","target_ko":"빨리 돌아가 보자"},{"source_id":"src_0286","target_ko":"정말 이쪽 맞지?"},{"source_id":"src_0287","target_ko":"뭔가 시원한 얘기 없냐고"},{"source_id":"src_0288","target_ko":"…귀신 들린 얘기…라든가…"},{"source_id":"src_0289","target_ko":"그건 너무 서늘하잖아!!"},{"source_id":"src_0290","target_ko":"사코, 뛰어!"},{"source_id":"src_0291","target_ko":"오우!"},{"source_id":"src_0292","target_ko":"오, 오우!"},{"source_id":"src_0293","target_ko":"으랴아아아아아!"},{"source_id":"src_0294","target_ko":"사코! 양쪽에서 끼웠어!"},{"source_id":"src_0295","target_ko":"오우! 역시 유코야!"},{"source_id":"src_0296","target_ko":"좋았어! 찾았다!"},{"source_id":"src_0297","target_ko":"미우 씨가 있는 곳으로 돌아가자."},{"source_id":"src_0298","target_ko":"야, 저거 봐!"},{"source_id":"src_0299","target_ko":"여는 방법을 찾아야겠네"},{"source_id":"src_0300","target_ko":"그럼, 다음 가볼까!"},{"source_id":"src_0301","target_ko":"사코…"},{"source_id":"src_0302","target_ko":"유코, 괜찮아?"},{"source_id":"src_0303","target_ko":"사코를 위해서라도 기운 내"},{"source_id":"src_0304","target_ko":"안 되겠네, 가슴골에 땀이…"},{"source_id":"src_0306","target_ko":"와아……"},{"source_id":"src_0307","target_ko":"우왓, 바글바글해!"},{"source_id":"src_0308","target_ko":"흐응, 그렇구나…"},{"source_id":"src_0309","target_ko":"음, 잘 안 보여…"},{"source_id":"src_0310","target_ko":"여긴 아까 봤어"},{"source_id":"src_0311","target_ko":"잠깐! 기다리라니까"},{"source_id":"src_0312","target_ko":"저기, 키사라기 씨…"},{"source_id":"src_0313","target_ko":"쉿, 집중 안 되잖아!"},{"source_id":"src_0314","target_ko":"레이지 패밀리였던가?"},{"source_id":"src_0315","target_ko":"아, 그 물먹는 놈들?"},{"source_id":"src_0316","target_ko":"말 그대로 발판이었지"},{"source_id":"src_0317","target_ko":"잘됐어"},{"source_id":"src_0318","target_ko":"부탁해, 유코를, 빨리…!"},{"source_id":"src_0319","target_ko":"알아! 서두르자!"},{"source_id":"src_0320","target_ko":"고마워, 얘들아…!"},{"source_id":"src_0321","target_ko":"보여… 이 앞…!"},{"source_id":"src_0322","target_ko":"이 안쪽에 있으려나?"},{"source_id":"src_0323","target_ko":"이번에야말로 때려눕힌다!"},{"source_id":"src_0324","target_ko":"춥고 차갑네…"},{"source_id":"src_0325","target_ko":"그러게, 빨리 돌아가야지…"},{"source_id":"src_0326","target_ko":"좋아, 서둘러 찾자!"},{"source_id":"src_0327","target_ko":"하아… 추워…"},{"source_id":"src_0328","target_ko":"그러게… 그래도 조금만 참자"},{"source_id":"src_0329","target_ko":"그래, 분명 금방 열릴 거야"},{"source_id":"src_0330","target_ko":"이건… 안 돼, 꽝이야"},{"source_id":"src_0331","target_ko":"음… 너무 크다"},{"source_id":"src_0332","target_ko":"구멍이랑 모양이 달라…"},{"source_id":"src_0333","target_ko":"으―! 너무 작아!"}]}

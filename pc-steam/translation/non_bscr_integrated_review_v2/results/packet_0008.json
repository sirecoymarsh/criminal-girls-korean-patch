{"rows":[{"source_id":"src_0597","target_ko":"준비됐제? 가자!"},{"source_id":"src_0598","target_ko":"간다! 이긴다! 돌격!"},{"source_id":"src_0599","target_ko":"괜찮아… 반드시 이길 수 있어!"},{"source_id":"src_0600","target_ko":"자, 공략해 주겠어!"},{"source_id":"src_0601","target_ko":"그나저나 으스스하네"},{"source_id":"src_0602","target_ko":"아래는 예뻤는디…"},{"source_id":"src_0603","target_ko":"빨리 찾아 줘야 해"},{"source_id":"src_0604","target_ko":"파란 문이 있어"},{"source_id":"src_0605","target_ko":"초록색 문이네"},{"source_id":"src_0606","target_ko":"보라색 문이네"},{"source_id":"src_0607","target_ko":"문을 지나면 길이 생겨"},{"source_id":"src_0608","target_ko":"또 파란 문이네…"},{"source_id":"src_0609","target_ko":"좋아, 이걸로 나아갈 수 있어!"},{"source_id":"src_0610","target_ko":"길이 다 보이진 않아"},{"source_id":"src_0611","target_ko":"선생님, 이제 마지막이고…"},{"source_id":"src_0612","target_ko":"컥!!"},{"source_id":"src_0613","target_ko":"방심할 틈이 없네!"},{"source_id":"src_0614","target_ko":"아, 젠장! 골치 아프네!"},{"source_id":"src_0615","target_ko":"크리미널… 강해…"},{"source_id":"src_0616","target_ko":"흥, 바라던 바야!"},{"source_id":"src_0617","target_ko":"선생은 강하려나"},{"source_id":"src_0618","target_ko":"글쎄… 직접 싸우진 않으니까"},{"source_id":"src_0619","target_ko":"벌주기는… 대단하지만"},{"source_id":"src_0620","target_ko":"…감옥… 이구나…"},{"source_id":"src_0621","target_ko":"왜 그래, 사코?"},{"source_id":"src_0622","target_ko":"응… 처음이 생각나서"},{"source_id":"src_0623","target_ko":"꺅! …넘어질 뻔했어"},{"source_id":"src_0624","target_ko":"선생님이랑 손잡으면 어때?"},{"source_id":"src_0625","target_ko":"…어! …아… 안 돼!"},{"source_id":"src_0626","target_ko":"선생님, 슬슬 쉬자"},{"source_id":"src_0627","target_ko":"토모에… 쉬기만 하는 거지?"},{"source_id":"src_0628","target_ko":"암흑 오라 대결이야…!"},{"source_id":"src_0629","target_ko":"선생, 이야기하자?"},{"source_id":"src_0630","target_ko":"어이 어이, 독차지냐?"},{"source_id":"src_0631","target_ko":"모, 모두의 선생이니까"},{"source_id":"src_0632","target_ko":"목소리, 이 앞에서 들려…"},{"source_id":"src_0633","target_ko":"그냥 보내 주진 않겠지"},{"source_id":"src_0634","target_ko":"그럼 결판낼 수밖에!"},{"source_id":"src_0635","target_ko":"정말 이상한 공간이네…"},{"source_id":"src_0636","target_ko":"조금 어지럽네…"},{"source_id":"src_0637","target_ko":"자주 쉬자, 응?"},{"source_id":"src_0638","target_ko":"최종 보스, 덤벼라―!"},{"source_id":"src_0639","target_ko":"이 앞에… 아마도…"},{"source_id":"src_0640","target_ko":"여러분, 괜찮으세요?"},{"source_id":"src_0641","target_ko":"후훗, 최강을 노리자!"},{"source_id":"src_0642","target_ko":"기, 기운 넘치네, 란…"},{"source_id":"src_0643","target_ko":"쎈 적도 묵사발이다!"},{"source_id":"src_0644","target_ko":"조금만 더, 힘내!"},{"source_id":"src_0645","target_ko":"나에게도, 이런 동료가…"},{"source_id":"src_0646","target_ko":"피곤하지 않으세요?"},{"source_id":"src_0647","target_ko":"마지막엔 실컷 날뛸 거야"},{"source_id":"src_0648","target_ko":"꺄―, 참 흉악하네!"},{"source_id":"src_0649","target_ko":"게이머의 피가 끓어올라!"},{"source_id":"src_0650","target_ko":"사코들의 승리이이!"},{"source_id":"src_0651","target_ko":"지옥 돌파는 괜한 게 아니야"},{"source_id":"src_0652","target_ko":"지옥에… 떨어지면 좋겠어"},{"source_id":"src_0653","target_ko":"어머, 그거 재미있네"},{"source_id":"src_0654","target_ko":"후우, 역시 숨겨진 곳이네"},{"source_id":"src_0655","target_ko":"이기면 되는 거야! 이기면!"},{"source_id":"src_0656","target_ko":"어제 왔어야지!"},{"source_id":"src_0657","target_ko":"란 씨, 억수로 남자답네"},{"source_id":"src_0658","target_ko":"시작은 순조롭네"},{"source_id":"src_0659","target_ko":"다음도 힘내자!"},{"source_id":"src_0660","target_ko":"이걸로 2마리…"},{"source_id":"src_0661","target_ko":"벌써 절반? 빠르네…"},{"source_id":"src_0662","target_ko":"아쉽지만 이제 1마리!"},{"source_id":"src_0663","target_ko":"좋아, 단숨에 가자!"},{"source_id":"src_0664","target_ko":"남은 건 최종 보스뿐이네"},{"source_id":"src_0665","target_ko":"엔딩까지 울지 마!"},{"source_id":"src_0666","target_ko":"쓰러뜨린… 건가?"},{"source_id":"src_0667","target_ko":"모두의 승리야!"},{"source_id":"src_0668","target_ko":"어떻게 여는 거지?"},{"source_id":"src_0669","target_ko":"흐응."},{"source_id":"src_0670","target_ko":"주웠어."},{"source_id":"src_0671","target_ko":"저건……"},{"source_id":"src_0672","target_ko":"혹시……"},{"source_id":"src_0673","target_ko":"…저쪽, 느껴져…."},{"source_id":"src_0674","target_ko":"선생… 기다려 주세요."},{"source_id":"src_0675","target_ko":"해냈다, 기뻐."},{"source_id":"src_0676","target_ko":"있었네!"}]}

{"rows":[{"source_id":"src_0093","target_ko":"영차, 영차!"},{"source_id":"src_0094","target_ko":"조심해서 가자!"},{"source_id":"src_0095","target_ko":"팍팍 나아가자!"},{"source_id":"src_0096","target_ko":"자, 가 볼까요"},{"source_id":"src_0097","target_ko":"힘내서 가 보자!"},{"source_id":"src_0098","target_ko":"꽤 많이 되돌아왔네…"},{"source_id":"src_0099","target_ko":"원점으로 돌아온 느낌?"},{"source_id":"src_0100","target_ko":"재수 없는 소리…"},{"source_id":"src_0101","target_ko":"왜 안 열리는 거야―!"},{"source_id":"src_0102","target_ko":"일단 돌아갈까"},{"source_id":"src_0103","target_ko":"오오!? 열렸어!?"},{"source_id":"src_0104","target_ko":"뭐야, 저 야한 방!"},{"source_id":"src_0105","target_ko":"또 벌주기…"},{"source_id":"src_0106","target_ko":"최악이잖아…!"},{"source_id":"src_0107","target_ko":"야호!"},{"source_id":"src_0108","target_ko":"싫어…"},{"source_id":"src_0109","target_ko":"으, 으으…"},{"source_id":"src_0110","target_ko":"용서 못 해!"},{"source_id":"src_0111","target_ko":"미안하데이"},{"source_id":"src_0112","target_ko":"하아, 무서웠어어"},{"source_id":"src_0113","target_ko":"간다아―!"},{"source_id":"src_0114","target_ko":"이젠 익숙해졌네"},{"source_id":"src_0115","target_ko":"출발 진행이야!"},{"source_id":"src_0116","target_ko":"좋아, 팍팍 가자!"},{"source_id":"src_0117","target_ko":"지금이라면… 알겠지…"},{"source_id":"src_0118","target_ko":"여긴 쾌적해…"},{"source_id":"src_0119","target_ko":"그래, 위층은 최악이야…"},{"source_id":"src_0120","target_ko":"뭔가… 느낌이 안 좋아…"},{"source_id":"src_0121","target_ko":"고마워하라고"},{"source_id":"src_0122","target_ko":"안 돼… 위험해…!"},{"source_id":"src_0123","target_ko":"쟤, 괜찮은 건가…"},{"source_id":"src_0124","target_ko":"모, 모른다니까!"},{"source_id":"src_0125","target_ko":"싫어… 앨리스 안 갈래…"},{"source_id":"src_0126","target_ko":"좋았어!"},{"source_id":"src_0127","target_ko":"해냈다!"},{"source_id":"src_0128","target_ko":"그럼, 가죠!"},{"source_id":"src_0129","target_ko":"앨리스, 힘낼게"},{"source_id":"src_0130","target_ko":"힘들었어―"},{"source_id":"src_0131","target_ko":"감옥살이―"},{"source_id":"src_0132","target_ko":"오오… 2명이 모였어…"},{"source_id":"src_0133","target_ko":"싫어, 진짜 갈 거야!?"},{"source_id":"src_0134","target_ko":"어쩔 수 없잖아!"},{"source_id":"src_0135","target_ko":"이, 이거 위험한데…"},{"source_id":"src_0136","target_ko":"없다기보다 애초에 없잖아"},{"source_id":"src_0137","target_ko":"캠프 침대 말이야…"},{"source_id":"src_0138","target_ko":"왠지 야해 보이지"},{"source_id":"src_0139","target_ko":"어―, 귀여운 것 같은데"},{"source_id":"src_0140","target_ko":"안내 잘 부탁해"},{"source_id":"src_0141","target_ko":"그나저나 사슬투성이네…"},{"source_id":"src_0142","target_ko":"대체 어디에 쓰는 건지"},{"source_id":"src_0143","target_ko":"…분위기 내기?"},{"source_id":"src_0144","target_ko":"선생님, 내 피곤하데이…"},{"source_id":"src_0145","target_ko":"좋아, 가자!"},{"source_id":"src_0146","target_ko":"나아가자―♪ 나아가자―♪"},{"source_id":"src_0147","target_ko":"왜 도망가는 거야, 귀찮게!"},{"source_id":"src_0148","target_ko":"아무튼 따라잡자"},{"source_id":"src_0149","target_ko":"유코… 유코―!"},{"source_id":"src_0150","target_ko":"야, 문이 닫혔어!?"},{"source_id":"src_0151","target_ko":"오, 열린 모양이네!"},{"source_id":"src_0152","target_ko":"어떻게 해야 열리지?"},{"source_id":"src_0153","target_ko":"그 애들을 찾자!"},{"source_id":"src_0154","target_ko":"뭐야?"},{"source_id":"src_0155","target_ko":"으으… 냄―새―나―…"},{"source_id":"src_0156","target_ko":"그러게, 뭔가 썩은 듯한…"},{"source_id":"src_0157","target_ko":"우웩… 속이 안 좋아졌어"},{"source_id":"src_0158","target_ko":"다른 데를 찾아보자"},{"source_id":"src_0159","target_ko":"어쩔 수 없지, 먼저 가자"},{"source_id":"src_0160","target_ko":"후후, 이젠 익숙하네"},{"source_id":"src_0161","target_ko":"이제 나아갈 수 있겠네!"},{"source_id":"src_0162","target_ko":"흐냐… 습기가…"},{"source_id":"src_0163","target_ko":"앗, 사코 머리가 축 늘어졌어"},{"source_id":"src_0164","target_ko":"고양이 귀 같아!"},{"source_id":"src_0165","target_ko":"헤헷"},{"source_id":"src_0166","target_ko":"어라, 뭐지?"},{"source_id":"src_0167","target_ko":"유코, 기다리고 있어!"},{"source_id":"src_0168","target_ko":"약 같은 게 있긴 한 거야?"},{"source_id":"src_0169","target_ko":"흥, 귀찮네…"},{"source_id":"src_0170","target_ko":"유코, 어디 간 거야아"},{"source_id":"src_0171","target_ko":"이 냄새… 약 냄새 같은데"},{"source_id":"src_0172","target_ko":"뭐, 확실히 효과는 있겠네"}]}
